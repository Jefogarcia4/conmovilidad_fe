{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/brand/*", "/hero/*", "*.{png,jpg,jpeg,svg,webp,ico,css,js,json,woff2}"]
  },
  "routes": [
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ],
  "mimeTypes": {
    ".json": "application/json",
    ".webp": "image/webp",
    ".woff2": "font/woff2"
  }
}
