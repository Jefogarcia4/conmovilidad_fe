<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración para App Service en Windows (IIS).

  Esta aplicación resuelve sus rutas en el navegador: `/home` o `/my-vehicles` no existen como
  archivos. Sin esta regla, al refrescar la página IIS busca un archivo con ese nombre y responde
  404. La reescritura le indica que sirva `index.html` y deje que React Router haga el resto.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="SPA" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- Los archivos y carpetas que sí existen (assets, imágenes, favicon) se sirven
                 tal cual: solo se reescribe lo que no corresponde a nada real. -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <!-- index.html nunca se cachea: si el navegador guarda una versión vieja seguiría
             pidiendo bundles que ya no existen tras un despliegue. -->
        <add name="Cache-Control" value="no-cache" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
